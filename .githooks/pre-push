#!/usr/bin/env bash
# Slower checks before anything leaves the machine (under a minute with a warm import cache):
# Godot's own errors and warnings against ci/warnings-baseline.txt, then the gdUnit4 suites.
# Enable once per clone: git config core.hooksPath .githooks. Skip with git push --no-verify;
# CI runs the same checks (jobs import and gdunit4).
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)" || exit 2
cd "$ROOT" || exit 2

# Pushes that only delete branches have nothing to check (git passes one "<ref> <sha> <ref> <sha>" line per ref)
pushing=0
while read -r _ local_sha _ _; do
	[[ "$local_sha" =~ ^0+$ ]] || pushing=1
done
[ $pushing -eq 1 ] || exit 0

GODOT="${GODOT_BIN:-}"
if [ -z "$GODOT" ]; then
	if command -v godot > /dev/null; then GODOT="$(command -v godot)"; else GODOT=/Applications/Godot.app/Contents/MacOS/Godot; fi
fi
test -x "$GODOT" || { echo "pre-push: Godot not found at $GODOT (set GODOT_BIN)" >&2; exit 1; }
# Every Godot call runs under a limit (scripts/tools/godot_timeout.sh): a hung Godot fails the push
source scripts/tools/godot_timeout.sh || exit 2

LOGS="$(mktemp -d)" || exit 2
trap 'rm -rf "$LOGS"' EXIT

echo "pre-push: import and compile every script (ci/load_all.gd)"
# Runs one Godot call under its limit into a log. Only a timeout fails here; check_log.py judges the logs.
godot_logged() {
	local log=$1
	shift
	with_timeout "$@" < /dev/null > "$log" 2>&1
	[ $? -eq 124 ] && { tail -1 "$log" >&2; exit 1; }
	return 0
}
# A fresh checkout's first import reports missing UID-cache errors, so it gets an extra run
[ -d .godot ] || godot_logged "$LOGS/import-1.log" GODOT_TIMEOUT_IMPORT 900 "pre-push: first import" "$GODOT" --headless --path . --import
godot_logged "$LOGS/import.log" GODOT_TIMEOUT_IMPORT 900 "pre-push: import" "$GODOT" --headless --path . --import
godot_logged "$LOGS/load-all.log" GODOT_TIMEOUT_RUN 600 "pre-push: load_all" "$GODOT" --headless --path . -s res://ci/load_all.gd -d
python3 ci/check_log.py --baseline ci/warnings-baseline.txt "$LOGS/import.log" "$LOGS/load-all.log" || exit 1

echo "pre-push: gdUnit4 suites (tests/run.sh)"
GODOT_BIN="$GODOT" tests/run.sh > "$LOGS/gdunit4.log" 2>&1
status=$?
if [ $status -ne 0 ]; then
	tail -40 "$LOGS/gdunit4.log" >&2
	echo "pre-push: tests/run.sh exited $status" >&2
	exit 1
fi
